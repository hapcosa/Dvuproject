# =============================================================================
# Proyecto DVU — variables de entorno
#
# Copiar a .env y completar:   cp .env.example .env
# El archivo .env NUNCA se versiona. Este archivo sí, y debe mantenerse al día:
# si agregas una variable en el código, agrégala aquí con un valor de ejemplo.
# =============================================================================

# --- General -----------------------------------------------------------------
DVU_ENV=development                  # development | staging | production
DVU_DEBUG=true
DVU_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
DVU_TZ=America/Santiago

# --- API ---------------------------------------------------------------------
DVU_API_HOST=0.0.0.0
DVU_API_PORT=8000
DVU_API_PREFIX=/api/v1
# Orígenes permitidos para CORS, separados por coma
DVU_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Seguridad ---------------------------------------------------------------
# GENERAR con: openssl rand -hex 32     ← NO usar este valor en producción
DVU_SECRET_KEY=cambiame-openssl-rand-hex-32
DVU_JWT_ALGORITHM=HS256
DVU_ACCESS_TOKEN_MINUTES=60
# Refresh largo: el vendedor en terreno no puede estar re-logueándose
DVU_REFRESH_TOKEN_DAYS=30

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=dvu
POSTGRES_PASSWORD=dvu_dev_password
POSTGRES_DB=dvu
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Se arma desde las anteriores; sobreescribir solo si se apunta a una BD externa
DVU_DATABASE_URL=postgresql+psycopg://dvu:dvu_dev_password@db:5432/dvu

# --- Redis (cola de jobs) ----------------------------------------------------
DVU_REDIS_URL=redis://redis:6379/0

# --- MinIO / S3 (imágenes de producto, comprobantes de pago) -----------------
MINIO_ROOT_USER=dvu_minio
MINIO_ROOT_PASSWORD=dvu_minio_dev_password
DVU_S3_ENDPOINT=http://minio:9000
DVU_S3_ACCESS_KEY=dvu_minio
DVU_S3_SECRET_KEY=dvu_minio_dev_password
DVU_S3_BUCKET=dvu
DVU_S3_REGION=us-east-1
DVU_S3_SECURE=false                  # true en producción (S3 real)

# --- Extractor de catálogo (Fase 0) ------------------------------------------
DVU_CATALOGO_DIR=/app/catalago
DVU_EXTRACTOR_OUTPUT_DIR=/app/data/extraccion
# Umbral bajo el cual una fila se marca para revisión manual
DVU_EXTRACTOR_CONFIANZA_MINIMA=0.60

# --- Reglas de negocio -------------------------------------------------------
DVU_IVA=0.19
# ¿Los precios del catálogo vienen con IVA incluido? (pregunta abierta, ver
# docs/00-plan-maestro.md §7). Supuesto actual: NETOS.
DVU_PRECIOS_INCLUYEN_IVA=false
DVU_MONEDA=CLP

# =============================================================================
# Integraciones externas — Fase 2. Vacías en desarrollo: el sistema usa los
# adaptadores Fake y levanta completo sin credenciales de terceros.
# =============================================================================

# --- Cartola bancaria (conciliación automática) ------------------------------
# fake | fintoc
# Con `fake` la cartola se lee de un archivo: `make cartola-demo` lo genera.
DVU_BANCO_PROVEEDOR=fake
DVU_BANCO_API_KEY=
DVU_BANCO_LINK_TOKEN=
DVU_BANCO_CUENTA_ID=
DVU_CARTOLA_FAKE_PATH=/app/data/cartola.jsonl
# Días hacia atrás que sincroniza una corrida sin rango explícito
DVU_CONCILIACION_DIAS_ATRAS=7

# --- Pago en línea -----------------------------------------------------------
# fake | fintoc | khipu | webpay
DVU_PAGOS_PROVEEDOR=fake
DVU_KHIPU_RECEIVER_ID=
DVU_KHIPU_SECRET=
DVU_WEBPAY_COMMERCE_CODE=
DVU_WEBPAY_API_KEY=
DVU_WEBPAY_AMBIENTE=integracion      # integracion | produccion

# --- DTE / SII (factura 33, guía de despacho 52, nota de crédito 61) ---------
# fake | api   (proveedor certificado: SimpleAPI, LibreDTE, OpenFactura)
DVU_DTE_PROVEEDOR=fake
DVU_DTE_API_KEY=
# certificacion | produccion. Emitir en producción es irreversible: un folio
# quemado sólo se corrige con nota de crédito. No lo cambies por costumbre.
DVU_DTE_AMBIENTE=certificacion

# Emisor. Va en cada DTE; con datos incompletos el SII rechaza el documento.
DVU_EMISOR_RUT=76000000-0
DVU_EMISOR_RAZON_SOCIAL=COMERCIAL DVU SPA
DVU_EMISOR_GIRO=DISTRIBUCION DE PRODUCTOS FERRETEROS Y DE CONSTRUCCION
DVU_EMISOR_DIRECCION=
DVU_EMISOR_COMUNA=

# --- WhatsApp Business API (notificaciones de estado) ------------------------
# fake | meta
DVU_WHATSAPP_PROVEEDOR=fake
DVU_WHATSAPP_PHONE_NUMBER_ID=
DVU_WHATSAPP_TOKEN=
DVU_WHATSAPP_VERIFY_TOKEN=

# --- Observabilidad (opcional) -----------------------------------------------
DVU_SENTRY_DSN=
